APP_ENV=development
LOG_LEVEL=INFO
OPENAI_API_KEY=your-openai-api-key-here
VECTOR_STORE_PATH=data/vector_store
TICKET_PROVIDER=jira
JIRA_BASE_URL=your-jira-instance.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=enter-your-jira-api-token-here
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task
# --- API ---
LOG_LEVEL=INFO
CORS_ORIGINS=
# --- Persistence (use postgres for production / multiple workers) ---
#CHECKPOINTER=sqlite          # memory | sqlite | postgres
CHECKPOINTER=postgres
DATABASE_URL=postgresql://smartdesk:smartdesk@localhost:5432/smartdesk
SQLITE_PATH=data/checkpoints.sqlite
DATABASE_URL=                  # postgresql://smartdesk:smartdesk@localhost:5432/smartdesk
LOCK_DATABASE_URL=             # optional; direct (non-PgBouncer-transaction-mode) DSN for locks
POSTGRES_POOL_SIZE=10
LOCK_POOL_SIZE=20
LOCK_TIMEOUT_SECONDS=30

# --- LangSmith (evals; optional tracing) ---
LANGSMITH_API_KEY=enter-your-langsmith-api-key-here
LANGSMITH_PROJECT=smartdesk-evals
LANGSMITH_TRACING=true        # true = also trace every OpenAI call made via LLMClient
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your workspace is in the EU